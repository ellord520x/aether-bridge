const fs = require('fs');
const { execSync } = require('child_process');

const GEMINI_API_KEY = process.env.GEMINI_API_KEY;
const SENTRY_PAYLOAD = process.env.SENTRY_PAYLOAD ? JSON.parse(process.env.SENTRY_PAYLOAD) : {};

async function callGemini(prompt) {
  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_API_KEY}`;
  const response = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      contents: [{ parts: [{ text: prompt }] }]
    })
  });
  const data = await response.json();
  if (!data.candidates || !data.candidates[0]) {
    throw new Error(`Gemini API Error: ${JSON.stringify(data)}`);
  }
  return data.candidates[0].content.parts[0].text;
}

async function main() {
  console.log('🚀 [Self-Healing] Starting analysis...');

  const errorContext = SENTRY_PAYLOAD.message || 'Unhandled exception detected in bridge execution.';
  const targetFile = SENTRY_PAYLOAD.file || 'relayer.js';

  if (!fs.existsSync(targetFile)) {
    console.log(`⚠️ Target file ${targetFile} not found. Defaulting to relayer.js`);
  }
  
  const currentCode = fs.existsSync(targetFile) ? fs.readFileSync(targetFile, 'utf8') : '// bridge relayer implementation';

  // المرحلة الأولى: وكيل تحليل الأمان (Security Agent)
  console.log('🔍 [1/3] Security Agent: Analyzing root cause...');
  const securityAnalysis = await callGemini(`
    You are a Web3 & Cross-Chain Security Auditor.
    Analyze this error: "${errorContext}"
    Affected code in ${targetFile}:
    \`\`\`javascript
    ${currentCode}
    \`\`\`
    Identify the exact bug and return a concise technical diagnosis.
  `);
  console.log('Diagnosis:', securityAnalysis);

  // المرحلة الثانية: وكيل كاتب الإصلاح (Code Fixer Agent)
  console.log('🛠️ [2/3] Code Fixer Agent: Generating code patch...');
  const fixedCodeRaw = await callGemini(`
    You are an Expert Software Engineer.
    Based on this security analysis: "${securityAnalysis}"
    Fix the code in ${targetFile}. 
    CRITICAL RULE: Preserve strict 1:1 cross-chain asset parity. Maintain exact token locked/minted amounts with zero fee/arbitrage deductions.
    Original Code:
    \`\`\`javascript
    ${currentCode}
    \`\`\`
    Return ONLY the full updated raw code inside a single javascript code block without extra conversational text.
  `);

  const codeMatch = fixedCodeRaw.match(/```javascript([\s\S]*?)```/) || fixedCodeRaw.match(/```([\s\S]*?)```/);
  const cleanFixedCode = codeMatch ? codeMatch[1].trim() : fixedCodeRaw.trim();

  // المرحلة الثالثة: وكيل التدقيق الحاسم (Code Reviewer Agent)
  console.log('🛡️ [3/3] Code Reviewer Agent: Auditing generated patch...');
  const reviewResult = await callGemini(`
    Review this fixed code for critical security flaws and syntax errors:
    \`\`\`javascript
    ${cleanFixedCode}
    \`\`\`
    Does it pass security and maintain 1:1 parity without broken logic? Reply with "APPROVED" as the first word if safe.
  `);

  if (!reviewResult.toUpperCase().includes('APPROVED')) {
    throw new Error(`Reviewer Agent rejected the patch: ${reviewResult}`);
  }

  console.log(`📝 Writing patch to ${targetFile}...`);
  fs.writeFileSync(targetFile, cleanFixedCode);

  console.log('🧪 Running automated unit tests...');
  try {
    execSync('npm test', { stdio: 'inherit' });
    console.log('✅ All unit tests passed successfully!');
  } catch (err) {
    console.error('❌ Unit tests failed after applying patch!');
    process.exit(1);
  }

  console.log('📌 Committing changes via Git CLI...');
  execSync('git checkout -b fix/auto-heal-patch');
  execSync(`git add ${targetFile}`);
  execSync('git commit -m "fix(self-healing): auto-repair bridge exception"');
  console.log('🎉 Self-healing lifecycle completed successfully!');
}

main().catch(err => {
  console.error('💥 Self-healing process failed:', err);
  process.exit(1);
});
